# API Configuration for Social Media Source Adapters
# Leave blank for unauthenticated / public metadata mode

# 1. YouTube Data API v3 (Google Cloud Console)
# Required to fetch live comment cascades and subscriber stats
YOUTUBE_API_KEY=

# 2. Reddit API (https://www.reddit.com/prefs/apps)
# Required for authorized OAuth access to Reddit comment trees
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=HateSpeechResearchPipeline/1.0

# 3. X (Twitter) API v2 (https://developer.x.com)
# Required to search and fetch live tweet replies (Academic/Pro tier)
X_BEARER_TOKEN=
